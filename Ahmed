  <script>
    /* ==============================================================
       1. إدارة الهوية وقفل الحساب (حمودي / سيمو)
    ============================================================== */
    let myRole = localStorage.getItem('alAman_myRole');
    let partnerRole = myRole === 'hamoudi' ? 'simo' : 'hamoudi';

    function initUserRole() {
      if (!myRole) {
        document.getElementById('roleModal').style.display = 'flex';
      } else {
        updateRoleBadge();
      }
    }

    function setAppRole(role) {
      localStorage.setItem('alAman_myRole', role);
      myRole = role;
      partnerRole = myRole === 'hamoudi' ? 'simo' : 'hamoudi';
      document.getElementById('roleModal').style.display = 'none';
      updateRoleBadge();
      loadDailyQuestion();
    }

    function updateRoleBadge() {
      const badge = document.getElementById('currentUserBadge');
      const badgeName = document.getElementById('badgeName');
      if (myRole === 'hamoudi') {
        badge.className = 'user-badge hamoudi';
        badgeName.innerText = 'أنا حمودي 👑 (شريكي: سيمو 🌸)';
      } else {
        badge.className = 'user-badge simo';
        badgeName.innerText = 'أنا سيمو 🌸 (شريكي: حمودي 👑)';
      }
    }

    function alertRoleLock() {
      alert(`حسابك مقفول ومربوط باسم: ${myRole === 'hamoudi' ? 'حمودي 👑' : 'سيمو 🌸'}.\nهذا لضمان خصوصيتك وعدم تداخل الإشعارات بينكما.`);
    }

    /* ==============================================================
       2. نظام الصوتيات والمؤثرات (Web Audio API)
    ============================================================== */
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playSirenSound() {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.type = 'sawtooth';
      
      let freq = 700;
      let rising = true;
      const interval = setInterval(() => {
        if (rising) {
          freq += 60;
          if (freq >= 1200) rising = false;
        } else {
          freq -= 60;
          if (freq <= 700) rising = true;
        }
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      }, 50);

      osc.start();
      setTimeout(() => {
        clearInterval(interval);
        osc.stop();
      }, 3500);
    }

    function playJoySound() {
      const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
      notes.forEach((freq, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime + idx * 0.15);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime + idx * 0.15);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + idx * 0.15 + 0.6);
        osc.start(audioCtx.currentTime + idx * 0.15);
        osc.stop(audioCtx.currentTime + idx * 0.15 + 0.6);
      });
    }

    /* ==============================================================
       3. الإشعارات والمنبه المباشر بالوقت
    ============================================================== */
    if ("Notification" in window && Notification.permission !== "granted") {
      Notification.requestPermission();
    }

    function showPhoneNotification(title, body) {
      if ("Notification" in window && Notification.permission === "granted") {
        new Notification(title, { body: body, icon: "🛡️" });
      }
    }

    function triggerSOS() {
      playSirenSound();
      showPhoneNotification("🚨 طوارئ SOS عاجلة!", `شريكك ${myRole === 'hamoudi' ? 'حمودي' : 'سيمو'} بحاجة ماسة إليك الآن!`);
      alert("🚨 تم إطلاق إنذار الطوارئ ومشاركة موقعك الدقيق فوراً والاتصال الهاتفي بشريكك!");
    }

    function triggerJoy() {
      playJoySound();
      confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
      showPhoneNotification("🎉 بشرى خير وفرحة!", `حاجة حلوة حصلت مع ${myRole === 'hamoudi' ? 'حمودي' : 'سيمو'}! رن عليه حالاً وافرح معاه!`);
    }

    function sendQuickPing(msg) {
      playJoySound();
      alert(`تم إرسال التنبيه فوراً: "${msg}"`);
      boostLoveMeter(3);
    }

    let activeAlarms = JSON.parse(localStorage.getItem('alAman_alarms') || '[]');

    function scheduleExactAlarm() {
      const timeVal = document.getElementById('alarmTimeInput').value;
      const noteVal = document.getElementById('alarmNoteInput').value || 'تنبيه حب ورعاية خاص 🤍';
      
      if (!timeVal) {
        alert("يرجى اختيار الوقت بالساعة والدقيقة أولاً!");
        return;
      }

      activeAlarms.push({ time: timeVal, note: noteVal, active: true });
      localStorage.setItem('alAman_alarms', JSON.stringify(activeAlarms));
      renderAlarms();
      alert(`تم ضبط المنبه بنجاح في تمام الساعة: ${timeVal}`);
    }

    function renderAlarms() {
      const container = document.getElementById('activeAlarmsList');
      container.innerHTML = '';
      activeAlarms.forEach((alm, idx) => {
        container.innerHTML += `
          <div class="alarm-item">
            <div>
              <strong>⏰ ${alm.time}</strong> - <span>${alm.note}</span>
            </div>
            <button class="ping-btn" style="color: red; border-color: red;" onclick="deleteAlarm(${idx})">حذف</button>
          </div>
        `;
      });
    }

    function deleteAlarm(idx) {
      activeAlarms.splice(idx, 1);
      localStorage.setItem('alAman_alarms', JSON.stringify(activeAlarms));
      renderAlarms();
    }

    // فحص المنبه كل ثانية بالوقت الحقيقي
    setInterval(() => {
      const now = new Date();
      const currentHours = String(now.getHours()).padStart(2, '0');
      const currentMinutes = String(now.getMinutes()).padStart(2, '0');
      const timeString = `${currentHours}:${currentMinutes}`;
      const currentSec = now.getSeconds();

      if (currentSec === 0) {
        activeAlarms.forEach(alm => {
          if (alm.time === timeString && alm.active) {
            playJoySound();
            showPhoneNotification(`⏰ حان الموعد: ${alm.time}`, alm.note);
          }
        });
      }
    }, 1000);

    /* ==============================================================
       4. مقياس الحب والصناديق الأربعة (رسائل متغيرة مع كل دورة)
    ============================================================== */
    let loveMeter = parseInt(localStorage.getItem('alAman_loveMeter') || '35');
    let messageCycle = parseInt(localStorage.getItem('alAman_msgCycle') || '0');

    // مجموعات الرسائل المتجددة
    const letterSets = [
      // المجموعة 1
      [
        "حبيبتي وروحي سيمو.. تعرفي يعني إيه 'الأمان'؟ الأمان يعني لما كل الدنيا تضيق وتقفل في وشي، مجرد ما أسمع صوتك أو أشوف ضحكتك، روحي ترجعلي وتهدى من تاني.. إنتِ دعوة أمي الصادقة اللي ربنا استجابها ليا وحطها في طريقي. بوعدك هفضل في ضهرك وسندك وحصنك لأخر نبضة في قلبي.",
        "إلى أميرتي وسيمو قلبي.. حنيتك بتمسح أي تعب في ثانية، ونظرة واحدة في عيونك بتديني طاقة أهد بيها جبال عشان أشوفك مبسوطة ومطمنة. ربنا يديمك نعمة في عمري وما يحرمني من وجودك.",
        "مستني اليوم اللي يتقفل علينا فيه باب بيت واحد، نسهر سوا، ونصحى على وش بعض، وكل خطوة بنمشيها سوا بتقربنا لأجمل حلم. قلبي وعيني مش شايفين غيرك في كل الدنيا.",
        "حمودي وسيمو.. لما بسمع أسامينا سوا، بحس بدفا وراحة ملهاش نهاية. إنتِ ملجأي وسري الصغير، وأنا واقع في غرامك كل يوم أكتر من اللي قبله."
      ],
      // المجموعة 2 (تتجدد تلقائياً عند 100%)
      [
        "سيمو الغالية.. في كل سجدة برفع إيدي للسما وأقول: يا رب احفظلي الهدية اللي نورت أيامي. إنتِ النور اللي بدد خوفي، والحضن اللي دايماً بتمنى أستخبى جواه من العالم كله.",
        "حبيبتي.. مش بس بحبك، أنا ممتن لكل ثانية بتستحمليني فيها وبتحسي بيا من غير ما أتكلم. وجودك في عمري خلاني أعرف طعم الأمان الحقيقي.",
        "وعد عهد رجولة وأمان.. مهما مرت السنين وكبرنا، هفضل أشوفك أجمل بنوتة في الكون وأحن قلب عليا، وعمري ما هسمح لدمعة تنزل من عينك إلا لو كانت دموع فرح.",
        "قلب حمودي وروحه.. انتِ مش مجرد حبيبة، انتِ وطني الصغير اللي ماليش مكان ولا راحة براه. بحبك حب يفيض عن الكون كله."
      ]
    ];

    function updateMeterUI() {
      document.getElementById('meterCircle').style.setProperty('--percent', loveMeter);
      document.getElementById('meterText').innerText = `${loveMeter}%`;

      const boxes = document.querySelectorAll('.surprise-box');
      if (loveMeter >= 100) {
        boxes.forEach(b => b.classList.remove('disabled'));
      } else {
        boxes.forEach(b => b.classList.add('disabled'));
      }
    }

    function boostLoveMeter(amount) {
      loveMeter += amount;
      if (loveMeter >= 100) {
        loveMeter = 100;
        confetti({ particleCount: 150 });
      }
      localStorage.setItem('alAman_loveMeter', loveMeter);
      updateMeterUI();
    }

    function openLoveBox(boxNumber) {
      if (loveMeter < 100) {
        alert("🔒 الصناديق تفتح فقط عند وصول مقياس الحب إلى 100%!");
        return;
      }

      const activeSet = letterSets[messageCycle % letterSets.length];
      const letter = activeSet[boxNumber - 1];

      document.getElementById('letterTitle').innerText = `💌 رسالة الصندوق رقم (${boxNumber})`;
      document.getElementById('letterBody').innerText = letter;
      document.getElementById('letterModal').classList.add('active');

      // عند فتح الصندوق الرابع تجدد الرسائل للدورة التالية وتصفير المقياس لبدء مغامرة جديدة
      if (boxNumber === 4) {
        messageCycle++;
        loveMeter = 20; // إعادة البدء
        localStorage.setItem('alAman_msgCycle', messageCycle);
        localStorage.setItem('alAman_loveMeter', loveMeter);
        setTimeout(updateMeterUI, 1000);
      }
    }

    function closeLetterModal() {
      document.getElementById('letterModal').classList.remove('active');
    }

    /* ==============================================================
       5. الشات والريكورد الصوتي الحقيقي
    ============================================================== */
    let mediaRecorder;
    let audioChunks = [];
    let isRecording = false;

    async function toggleVoiceRecord() {
      const recordBtn = document.getElementById('voiceRecordBtn');
      if (!isRecording) {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(stream);
          audioChunks = [];
          mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
          mediaRecorder.onstop = () => {
            const audioBlob = new Blob(audioChunks, { type: 'audio/mp3' });
            const audioUrl = URL.createObjectURL(audioBlob);
            appendChatMessage(`🎤 تسجيل صوتي (${new Date().toLocaleTimeString('ar-EG', {hour:'2-digit', minute:'2-digit'})})`, true, audioUrl);
          };
          mediaRecorder.start();
          isRecording = true;
          recordBtn.classList.add('recording');
        } catch (err) {
          alert("يرجى إعطاء إذن المايكروفون لتسجيل الريكورد!");
        }
      } else {
        mediaRecorder.stop();
        isRecording = false;
        recordBtn.classList.remove('recording');
      }
    }

    function sendChatMessage() {
      const input = document.getElementById('chatInput');
      const text = input.value.trim();
      if (!text) return;
      appendChatMessage(text, false);
      input.value = '';
      boostLoveMeter(2);
    }

    function appendChatMessage(content, isAudio = false, audioSrc = null) {
      const box = document.getElementById('chatBox');
      const time = new Date().toLocaleTimeString('ar-EG', {hour: '2-digit', minute:'2-digit'});
      const msg = document.createElement('div');
      msg.className = 'msg-bubble msg-mine';
      
      if (isAudio) {
        msg.innerHTML = `<div>${content}</div><audio controls src="${audioSrc}" style="width: 100%; margin-top: 5px; height: 35px;"></audio><span class="msg-time">${time}</span>`;
      } else {
        msg.innerHTML = `<div>${content}</div><span class="msg-time">${time}</span>`;
      }

      box.appendChild(msg);
      box.scrollTop = box.scrollHeight;
    }

    function handleImageSend(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
          const box = document.getElementById('chatBox');
          const time = new Date().toLocaleTimeString('ar-EG', {hour: '2-digit', minute:'2-digit'});
          const msg = document.createElement('div');
          msg.className = 'msg-bubble msg-mine';
          msg.innerHTML = `<img src="${e.target.result}" style="max-width: 100%; border-radius: 12px; margin-bottom: 4px;"><span class="msg-time">${time}</span>`;
          box.appendChild(msg);
          box.scrollTop = box.scrollHeight;
          boostLoveMeter(5);
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    /* ==============================================================
       6. المناسبات وتواريخ الذكريات مع التعديل
    ============================================================== */
    let eventsList = JSON.parse(localStorage.getItem('alAman_events') || JSON.stringify([
      { name: "عيد ميلاد سيمو 🌸", date: "2026-11-20" },
      { name: "عيد ميلاد حمودي 👑", date: "2026-08-15" },
      { name: "يوم حبنا الأبدي 💍", date: "2024-05-10" }
    ]));

    function renderEvents() {
      const display = document.getElementById('eventsListDisplay');
      display.innerHTML = '';
      eventsList.forEach(ev => {
        const diffDays = Math.ceil((new Date(ev.date) - new Date()) / (1000 * 60 * 60 * 24));
        display.innerHTML += `
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 12px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <div style="font-weight: 800; color: var(--primary-dark);">${ev.name}</div>
              <div style="font-size: 0.78rem; color: var(--text-muted);">${ev.date}</div>
            </div>
            <div style="font-weight: 800; font-size: 0.82rem; color: ${diffDays >= 0 ? '#059669' : '#dc2626'};">
              ${diffDays >= 0 ? `باقي ${diffDays} يوم` : 'ذكرى غالية مرّت 🤍'}
            </div>
          </div>
        `;
      });
    }

    function toggleEventEdit() {
      const sec = document.getElementById('eventEditSection');
      sec.style.display = sec.style.display === 'none' ? 'block' : 'none';
    }

    function addNewCustomEvent() {
      const name = document.getElementById('newEventName').value;
      const date = document.getElementById('newEventDate').value;
      if (!name || !date) return alert("يرجى ملء الاسم والتاريخ!");
      eventsList.push({ name, date });
      localStorage.setItem('alAman_events', JSON.stringify(eventsList));
      renderEvents();
      toggleEventEdit();
    }

    /* ==============================================================
       7. الأسئلة المفاجئة اليومية
    ============================================================== */
    const dailyQuestions = [
      "إيه أكتر حاجة بتطمنك ومبتلاقيش زيها إلا في حضن وعين حبيبك؟",
      "لو هتوصف أماننا بكلمة واحدة بس من أول ما عرفنا بعض، هتكون إيه؟",
      "إيه أكتر ذكرى صغيرة حصلت بينا مستحيل تتمسح من بالك مهما عشنا؟"
    ];

    function loadDailyQuestion() {
      const qIndex = new Date().getDate() % dailyQuestions.length;
      document.getElementById('todayQuestionText').innerText = dailyQuestions[qIndex];
    }

    function submitDailyAnswer() {
      const ans = document.getElementById('questionAnswerInput').value;
      if (!ans) return alert("اكتب إجابتك أولاً!");
      document.getElementById('partnerAnswerBox').style.display = 'block';
      document.getElementById('partnerAnswerText').innerText = ans;
      alert("تم إرسال إجابتك لشريكك ووصله إشعار فوري بها 🤍!");
      boostLoveMeter(10);
    }

    /* ==============================================================
       8. تتبع الـ GPS المباشر
    ============================================================== */
    let map, userMarker, partnerMarker;
    let gpsActive = true;

    function initMap() {
      map = L.map('map').setView([30.0444, 31.2357], 13);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
      }).addTo(map);

      userMarker = L.marker([30.0444, 31.2357]).addTo(map).bindPopup("موقعي الحالي").openPopup();
      partnerMarker = L.marker([30.0500, 31.2400]).addTo(map).bindPopup("مكان شريكي الآن 🤍");

      if (navigator.geolocation) {
        navigator.geolocation.watchPosition(pos => {
          if (!gpsActive) return;
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          userMarker.setLatLng([lat, lng]);
          map.setView([lat, lng], 14);
        });
      }
    }

    function toggleGpsTracking() {
      gpsActive = !gpsActive;
      const btn = document.getElementById('gpsToggleBtn');
      if (gpsActive) {
        btn.innerText = "🟢 تتبع حركتنا: نشط";
        btn.style.color = "#059669";
      } else {
        btn.innerText = "🔴 تتبع حركتنا: متوقف";
        btn.style.color = "#dc2626";
      }
    }

    /* ==============================================================
       9. تبديل الشاشات
    ============================================================== */
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

      document.getElementById(`tab-${tabId}`).classList.add('active');
      event.currentTarget.classList.add('active');

      if (tabId === 'gps') {
        setTimeout(() => map.invalidateSize(), 200);
      }
    }

    // التهيئة الشاملة عند التشغيل
    window.addEventListener('load', () => {
      initUserRole();
      updateMeterUI();
      renderAlarms();
      renderEvents();
      loadDailyQuestion();
      initMap();
    });
  </script>
</body>
</html>
