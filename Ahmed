  <!-- نافذة قراءة رسائل الصناديق -->
  <div id="letterModal" class="modal-overlay">
    <div class="modal-card">
      <div style="font-size: 2.8rem; margin-bottom: 6px;">💌</div>
      <h3 id="letterTitle" style="color: var(--primary-dark); font-weight: 800;">رسالة حب من القلب</h3>
      <div id="letterBody" class="letter-content"></div>
      <button class="btn-primary" onclick="closeLetterModal()">إغلاق وحفظ في الذاكرة 🤍</button>
