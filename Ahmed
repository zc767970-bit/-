<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>تطبيق الأمان 🤍 حمودي & سيمو</title>
  
  <!-- خط كايو الأنيق -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- مكتبة الخرائط المباشرة Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- مؤثرات الاحتفال Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    :root {
      --primary: #e11d48;
      --primary-light: #ffe4e6;
      --primary-dark: #9f1239;
      --secondary: #8b5cf6;
      --bg-dark: #0f172a;
      --card-bg: rgba(255, 255, 255, 0.95);
      --card-border: rgba(226, 232, 240, 0.8);
      --text-main: #1e293b;
      --text-muted: #64748b;
      --gold: #f59e0b;
      --radius: 20px;
      --shadow: 0 10px 25px -5px rgba(225, 29, 72, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Cairo', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: linear-gradient(135deg, #fff1f2 0%, #f5f3ff 50%, #eff6ff 100%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      padding-bottom: 85px;
    }

    /* شريط الرأس المميز */
    header {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 12px 18px;
      border-bottom: 1px solid rgba(244, 63, 94, 0.15);
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    .app-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .app-logo {
      width: 42px;
      height: 42px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      box-shadow: 0 4px 12px rgba(225, 29, 72, 0.3);
    }

    .app-title h1 {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--primary-dark);
      line-height: 1.1;
    }

    .app-title p {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .user-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 30px;
      background: #f1f5f9;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-main);
      border: 1px solid #e2e8f0;
      cursor: pointer;
    }

    .user-badge.hamoudi {
      background: #e0f2fe;
      color: #0369a1;
      border-color: #bae6fd;
    }

    .user-badge.simo {
      background: #fce7f3;
      color: #be185d;
      border-color: #fbcfe8;
    }

    /* الحاوية الأساسية */
    main {
      flex: 1;
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
      padding: 16px;
    }

    .tab-content {
      display: none;
      animation: fadeIn 0.25s ease-in-out;
    }

    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* الكروت */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: var(--shadow);
      border: 1px solid var(--card-border);
      position: relative;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 800;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--primary-dark);
    }

    /* الأزرار السريعة بالأعلى */
    .quick-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }

    .action-btn {
      padding: 14px 12px;
      border-radius: 16px;
      border: none;
      font-weight: 700;
      font-size: 0.92rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    }

    .action-btn:active {
      transform: scale(0.97);
    }

    .btn-sos {
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: white;
      grid-column: span 1;
    }

    .btn-joy {
      background: linear-gradient(135deg, #ec4899, #db2777);
      color: white;
      grid-column: span 1;
    }

    .btn-safe {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      grid-column: span 2;
      flex-direction: row;
      justify-content: center;
    }

    /* أزرار نبضات الحب */
    .pings-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-top: 10px;
    }

    .ping-btn {
      background: #fff;
      border: 1px solid #fecdd3;
      padding: 10px;
      border-radius: 14px;
      font-size: 0.8rem;
      font-weight: 700;
      color: #9f1239;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: 0.2s;
    }

    .ping-btn:hover {
      background: #ffe4e6;
    }

    /* إعدادات المنبه بالوقت المحدد */
    .input-group {
      margin-bottom: 12px;
    }

    .input-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .input-control {
      width: 100%;
      padding: 12px;
      border-radius: 14px;
      border: 1px solid #cbd5e1;
      font-size: 0.95rem;
      outline: none;
      background: #f8fafc;
    }

    .input-control:focus {
      border-color: var(--primary);
      background: #fff;
    }

    .btn-primary {
      width: 100%;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      border: none;
      padding: 13px;
      border-radius: 14px;
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      transition: 0.2s;
    }

    /* قائمة المنبهات المجدولة */
    .alarms-list {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .alarm-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      font-size: 0.85rem;
    }

    /* الشات */
    .chat-box {
      height: 380px;
      overflow-y: auto;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      background: #fdf2f8;
      border-radius: 18px;
      border: 1px solid #fbcfe8;
      margin-bottom: 12px;
    }

    .msg-bubble {
      max-width: 82%;
      padding: 10px 14px;
      border-radius: 16px;
      font-size: 0.9rem;
      line-height: 1.4;
      position: relative;
    }

    .msg-mine {
      align-self: flex-start;
      background: linear-gradient(135deg, var(--primary), #f43f5e);
      color: white;
      border-bottom-right-radius: 4px;
    }

    .msg-partner {
      align-self: flex-end;
      background: white;
      color: var(--text-main);
      border: 1px solid #e2e8f0;
      border-bottom-left-radius: 4px;
    }

    .msg-time {
      font-size: 0.65rem;
      opacity: 0.75;
      margin-top: 4px;
      display: block;
      text-align: left;
    }

    .chat-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .record-btn {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: #ef4444;
      color: white;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      cursor: pointer;
      flex-shrink: 0;
    }

    .record-btn.recording {
      animation: pulse 1s infinite;
      background: #b91c1c;
    }

    @keyframes pulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
      100% { transform: scale(1); }
    }

    /* مقياس الحب والصناديق الأربعة */
    .love-meter-container {
      text-align: center;
      padding: 15px 0;
    }

    .meter-circle {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: conic-gradient(var(--primary) calc(var(--percent) * 1%), #fee2e2 0);
      margin: 0 auto 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 20px rgba(225, 29, 72, 0.2);
      transition: all 0.5s ease;
    }

    .meter-inner {
      width: 112px;
      height: 112px;
      border-radius: 50%;
      background: white;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 1.5rem;
      color: var(--primary);
    }

    .boxes-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 15px;
    }

    .surprise-box {
      background: linear-gradient(135deg, #fff, #fff1f2);
      border: 2px dashed #fda4af;
      border-radius: 16px;
      padding: 18px 10px;
      text-align: center;
      cursor: pointer;
      transition: 0.3s;
    }

    .surprise-box.disabled {
      opacity: 0.45;
      cursor: not-allowed;
      border-color: #cbd5e1;
    }

    .surprise-box .box-icon {
      font-size: 2.2rem;
      margin-bottom: 6px;
      display: block;
    }

    /* المودال لقراءة الرسالة */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(5px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-card {
      background: white;
      border-radius: 24px;
      width: 100%;
      max-width: 440px;
      padding: 24px;
      text-align: center;
      position: relative;
      animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes popIn {
      from { transform: scale(0.85); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .letter-content {
      font-size: 1.05rem;
      line-height: 1.7;
      color: #334155;
      background: #fff7ed;
      padding: 16px;
      border-radius: 16px;
      border: 1px solid #fed7aa;
      margin: 15px 0;
      text-align: right;
    }

    /* شريط التنقل السفلي في الموبايل */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(12px);
      border-top: 1px solid rgba(226, 232, 240, 0.8);
      display: flex;
      justify-content: space-around;
      padding: 8px 6px;
      z-index: 100;
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--text-muted);
      border: none;
      background: none;
      cursor: pointer;
      width: 16%;
    }

    .nav-item.active {
      color: var(--primary);
    }

    .nav-item span.icon {
      font-size: 1.3rem;
    }

    /* الخريطة */
    #map {
      height: 280px;
      border-radius: 18px;
      border: 1px solid #cbd5e1;
      margin-bottom: 12px;
      z-index: 1;
    }

    /* مفتاح قفل الهوية في البداية */
    .role-modal {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.85);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .role-card {
      background: white;
      border-radius: 28px;
      padding: 28px 20px;
      max-width: 380px;
      width: 100%;
      text-align: center;
    }

    .role-btn {
      width: 100%;
      padding: 16px;
      margin-top: 12px;
      border-radius: 18px;
      border: 2px solid transparent;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: 0.2s;
    }

    .role-btn-hamoudi {
      background: #e0f2fe;
      color: #0369a1;
      border-color: #7dd3fc;
    }

    .role-btn-simo {
      background: #fce7f3;
      color: #be185d;
      border-color: #f472b6;
    }
  </style>
</head>
<body>

  <!-- شاشة تحديد الهوية المرة الأولى -->
  <div id="roleModal" class="role-modal" style="display: none;">
    <div class="role-card">
      <div style="font-size: 3rem; margin-bottom: 10px;">🤍🔐</div>
      <h2 style="color: var(--primary-dark); font-weight: 900; margin-bottom: 6px;">مرحباً بك في الأمان</h2>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 18px;">
        من فضلك اختر هويتك الشخصية. سيتم قفل الهاتف على هذا الحساب لضمان خصوصية وربط التطبيق بينكما.
      </p>
      
      <button class="role-btn role-btn-hamoudi" onclick="setAppRole('hamoudi')">
        <span>👑</span> أنا حمودي
      </button>

      <button class="role-btn role-btn-simo" onclick="setAppRole('simo')">
        <span>🌸</span> أنا سيمو
      </button>
    </div>
  </div>

  <!-- الشريط العلوي -->
  <header>
    <div class="app-brand">
      <div class="app-logo">🛡️</div>
      <div class="app-title">
        <h1>الأمـــان</h1>
        <p>حمودي & سيمو للأبد 🤍</p>
      </div>
    </div>
    <div id="currentUserBadge" class="user-badge" onclick="alertRoleLock()">
      <span>👤</span> <span id="badgeName">جاري التحميل...</span>
    </div>
  </header>

  <!-- المحتوى الرئيسي -->
  <main>

    <!-- 1. تبويب الإشعارات والمنبه (الافتتاحي والرئيسي) -->
    <div id="tab-alerts" class="tab-content active">
      <!-- أزرار الطوارئ والبشرى -->
      <div class="quick-actions">
        <button class="action-btn btn-sos" onclick="triggerSOS()">
          <span style="font-size: 1.5rem;">🚨</span>
          <span>طوارئ SOS فورية</span>
        </button>

        <button class="action-btn btn-joy" onclick="triggerJoy()">
          <span style="font-size: 1.5rem;">🎉</span>
          <span>حاجة حلوة حصلت!</span>
        </button>

        <button class="action-btn btn-safe" onclick="sendQuickPing('🚗 أنا وصلت بالسلامة وطمنتك عليا 🤍')">
          <span>🚗 وصلت بالسلامة والحمد لله</span>
        </button>
      </div>

      <!-- نبضات الحب اللحظية -->
      <div class="card">
        <div class="card-title"><span>💌</span> إرسال نبضة حب فورية:</div>
        <div class="pings-grid">
          <button class="ping-btn" onclick="sendQuickPing('دعيتلك فجأة ربنا يحفظك ليا 🤍')">🤍 دعيتلك فجأة</button>
          <button class="ping-btn" onclick="sendQuickPing('اشرب مياه يا قلبي ومتنساش نفسك 🥤')">🥤 اشرب مياه</button>
          <button class="ping-btn" onclick="sendQuickPing('ابتسم عشان ضحكتك بتنور دنيتي 🌸')">🌸 ابتسم يا روحي</button>
          <button class="ping-btn" onclick="sendQuickPing('وحشتني أوي في نص اليوم 🥺')">🥺 وحشتني أوي</button>
        </div>
      </div>

      <!-- جدولة المنبه المحدد بالساعة والدقيقة -->
      <div class="card">
        <div class="card-title"><span>⏰</span> ضبط منبه بالوقت المحدد بدقة:</div>
        
        <div class="input-group">
          <label>اختر وقت الرنين الدقيق:</label>
          <input type="time" id="alarmTimeInput" class="input-control">
        </div>

        <div class="input-group">
          <label>رسالة المنبه لشريكك:</label>
          <input type="text" id="alarmNoteInput" class="input-control" placeholder="مثال: جه وقت دوانا / وقت كلمتنا الخاصة 🤍">
        </div>

        <button class="btn-primary" onclick="scheduleExactAlarm()">🔔 تفعيل المنبه الآن</button>

        <div class="alarms-list" id="activeAlarmsList">
          <!-- المنبهات المجدولة تظهر هنا -->
        </div>
      </div>
    </div>

    <!-- 2. تبويب الشات والصوت والصور -->
    <div id="tab-chat" class="tab-content">
      <div class="card">
        <div class="card-title"><span>💬</span> محادثتنا الخاصة والآمنة</div>
        <div class="chat-box" id="chatBox">
          <!-- الرسائل المتبادلة -->
        </div>

        <div class="chat-controls">
          <input type="file" id="photoUpload" accept="image/*" style="display: none;" onchange="handleImageSend(this)">
          <button class="ping-btn" style="padding: 10px;" onclick="document.getElementById('photoUpload').click()">📷</button>
          
          <input type="text" id="chatInput" class="input-control" placeholder="اكتب لحبيبك هنا..." onkeypress="if(event.key==='Enter') sendChatMessage()">
          
          <button class="record-btn" id="voiceRecordBtn" onclick="toggleVoiceRecord()">🎙️</button>
          <button class="ping-btn" style="background: var(--primary); color: white;" onclick="sendChatMessage()">إرسال</button>
        </div>
      </div>
    </div>

    <!-- 3. مقياس الحب والصناديق الأربعة -->
    <div id="tab-love" class="tab-content">
      <div class="card">
        <div class="card-title"><span>💖</span> مقياس مدى الحب بيننا</div>
        <div class="love-meter-container">
          <div class="meter-circle" id="meterCircle" style="--percent: 30;">
            <div class="meter-inner">
              <span id="meterText">30%</span>
            </div>
          </div>
          <p style="font-size: 0.85rem; color: var(--text-muted); font-weight: 700;">
            يزداد المقياس تلقائياً مع تفاعلكما ورسائلكم وحل الأسئلة! عند 100% تفتح الصناديق.
          </p>
        </div>

        <div class="card-title" style="margin-top: 15px;"><span>🎁</span> الصناديق الأربعة للرسائل السرية:</div>
        <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 8px;">
          كل صندوق يحتوي على رسالة عهد وغرام خاصة، وتتغير الرسائل تلقائياً في كل دورة!
        </p>

        <div class="boxes-grid">
          <div class="surprise-box disabled" id="box-1" onclick="openLoveBox(1)">
            <span class="box-icon">📦</span>
            <div style="font-weight: 800; font-size: 0.85rem;">صندوق الوفاء</div>
          </div>

          <div class="surprise-box disabled" id="box-2" onclick="openLoveBox(2)">
            <span class="box-icon">🎀</span>
            <div style="font-weight: 800; font-size: 0.85rem;">صندوق العهد</div>
          </div>

          <div class="surprise-box disabled" id="box-3" onclick="openLoveBox(3)">
            <span class="box-icon">💌</span>
            <div style="font-weight: 800; font-size: 0.85rem;">صندوق السكينة</div>
          </div>

          <div class="surprise-box disabled" id="box-4" onclick="openLoveBox(4)">
            <span class="box-icon">👑</span>
            <div style="font-weight: 800; font-size: 0.85rem;">صندوق المستقبل</div>
          </div>
        </div>

        <button class="ping-btn" style="width: 100%; margin-top: 14px; justify-content: center;" onclick="boostLoveMeter(15)">
          ✨ زيادة مقياس الحب الآن للتجربة
        </button>
      </div>
    </div>

    <!-- 4. تبويب المناسبات وتواريخ الذكريات (مع التعديل الحر) -->
    <div id="tab-events" class="tab-content">
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
